# ---- Supabase database ----
# Supabase Dashboard -> your project -> Connect (top bar) -> "Session pooler" -> URI.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---- Supabase Storage (optional, for profile photos & PO/PI/quotation files) ----
# Dashboard -> Project Settings -> API. Leave blank to store files in server/uploads instead.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=crm-files

# ---- App ----
PORT=5000
JWT_SECRET=replace-with-a-long-random-string
# First admin account, created automatically on first start
ADMIN_EMAIL=admin@crm.com
ADMIN_PASSWORD=admin123
# Prefix for PO / quotation / PI / SO numbers, e.g. LAP/PO/25-26/001
DOC_PREFIX=LAP
# Minutes ahead of UTC for "Today's Converted" etc. (IST = 330)
TZ_OFFSET_MINUTES=330

# ---- Gmail for "Email Leads" (Lead Filler), optional ----
# Google Cloud Console -> APIs & Services: enable the Gmail API, then Credentials ->
# Create OAuth client ID -> Web application, with this exact Authorized redirect URI.
# Local development: http://localhost:5173/api/gmail/callback  (Vite forwards it to the API)
# Deployed: https://your-crm-domain/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/gmail/callback
# Set to 1 to try the Email Leads page with a sample inbox (no Google account needed)
GMAIL_MOCK=0
